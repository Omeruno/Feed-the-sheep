{
  "name": "terrarium",
  "version": "0.1.0",
  "description": "A self-contained ecosystem simulation with emergent, evolving agent behavior.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "esbuild scripts/balance-check.ts --bundle --platform=node --format=esm --outfile=.tmp/balance-check.mjs && node .tmp/balance-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.3.1"
  }
}
